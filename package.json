{
  "name": "work-monitor",
  "displayName": "Work Monitor",
  "description": "Automatic time tracking per task from your git branch, with a daily timesheet ready for Odoo.",
  "version": "0.4.0",
  "publisher": "sandun",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.93.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "extensionDependencies": [
    "vscode.git"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": false
  },
  "contributes": {
    "commands": [
      {
        "command": "workMonitor.createTaskBranch",
        "title": "Create Task Branch…",
        "category": "Work Monitor",
        "icon": "$(git-branch)"
      },
      {
        "command": "workMonitor.trackBranch",
        "title": "Track This Branch",
        "category": "Work Monitor",
        "icon": "$(eye)"
      },
      {
        "command": "workMonitor.openTimesheet",
        "title": "Open Timesheet",
        "category": "Work Monitor",
        "icon": "$(table)"
      },
      {
        "command": "workMonitor.startManualTask",
        "title": "Start Non-Jira Task…",
        "category": "Work Monitor",
        "icon": "$(add)"
      },
      {
        "command": "workMonitor.stopManualTask",
        "title": "Stop Non-Jira Task",
        "category": "Work Monitor",
        "icon": "$(debug-stop)"
      },
      {
        "command": "workMonitor.pause",
        "title": "Pause Tracking",
        "category": "Work Monitor",
        "icon": "$(debug-pause)"
      },
      {
        "command": "workMonitor.resume",
        "title": "Resume Tracking",
        "category": "Work Monitor",
        "icon": "$(debug-start)"
      },
      {
        "command": "workMonitor.addNote",
        "title": "Add Note to Current Task…",
        "category": "Work Monitor",
        "icon": "$(comment)"
      },
      {
        "command": "workMonitor.refresh",
        "title": "Refresh",
        "category": "Work Monitor",
        "icon": "$(refresh)"
      },
      {
        "command": "workMonitor.openInJira",
        "title": "Open in Jira",
        "category": "Work Monitor",
        "icon": "$(link-external)"
      },
      {
        "command": "workMonitor.connectJira",
        "title": "Connect Jira…",
        "category": "Work Monitor"
      },
      {
        "command": "workMonitor.connectAgent",
        "title": "Connect Coding Agent (Claude Code, Copilot…)…",
        "category": "Work Monitor",
        "icon": "$(sparkle)"
      },
      {
        "command": "workMonitor.statusMenu",
        "title": "Show Menu",
        "category": "Work Monitor"
      },
      {
        "command": "workMonitor.openDataFolder",
        "title": "Open Data Folder",
        "category": "Work Monitor"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "workMonitor",
          "title": "Work Monitor",
          "icon": "resources/icon.svg"
        }
      ]
    },
    "views": {
      "workMonitor": [
        {
          "id": "workMonitor.today",
          "name": "Today"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "workMonitor.today",
        "contents": "Nothing tracked yet today.\nCreate a task branch (issue/TEST-101-…) and start working — time is tracked automatically.\n[Create Task Branch](command:workMonitor.createTaskBranch)\n[Start Non-Jira Task](command:workMonitor.startManualTask)\n[Open Timesheet](command:workMonitor.openTimesheet)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "workMonitor.createTaskBranch",
          "when": "view == workMonitor.today",
          "group": "navigation@0"
        },
        {
          "command": "workMonitor.openTimesheet",
          "when": "view == workMonitor.today",
          "group": "navigation@1"
        },
        {
          "command": "workMonitor.startManualTask",
          "when": "view == workMonitor.today && !workMonitor.manual",
          "group": "navigation@2"
        },
        {
          "command": "workMonitor.stopManualTask",
          "when": "view == workMonitor.today && workMonitor.manual",
          "group": "navigation@2"
        },
        {
          "command": "workMonitor.pause",
          "when": "view == workMonitor.today && !workMonitor.paused",
          "group": "navigation@3"
        },
        {
          "command": "workMonitor.resume",
          "when": "view == workMonitor.today && workMonitor.paused",
          "group": "navigation@3"
        },
        {
          "command": "workMonitor.refresh",
          "when": "view == workMonitor.today",
          "group": "navigation@4"
        },
        {
          "command": "workMonitor.connectJira",
          "when": "view == workMonitor.today",
          "group": "more@1"
        },
        {
          "command": "workMonitor.connectAgent",
          "when": "view == workMonitor.today",
          "group": "more@2"
        },
        {
          "command": "workMonitor.openDataFolder",
          "when": "view == workMonitor.today",
          "group": "more@3"
        }
      ],
      "view/item/context": [
        {
          "command": "workMonitor.openInJira",
          "when": "view == workMonitor.today && viewItem == jiraTask",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "workMonitor.openInJira",
          "when": "false"
        },
        {
          "command": "workMonitor.statusMenu",
          "when": "false"
        },
        {
          "command": "workMonitor.trackBranch",
          "when": "workMonitor.canTrackBranch"
        }
      ]
    },
    "configuration": {
      "title": "Work Monitor",
      "properties": {
        "workMonitor.taskKeyPattern": {
          "type": "string",
          "default": "[A-Z][A-Z0-9]+-\\d+",
          "scope": "application",
          "description": "Regular expression that finds the Jira task key in a branch name or commit message."
        },
        "workMonitor.trackOnlyCreatedBranches": {
          "type": "boolean",
          "default": true,
          "description": "Track only branches made with \"Create Task Branch\" or added with \"Track This Branch\". Turn off to track every branch you check out."
        },
        "workMonitor.generalBranches": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "main",
            "master",
            "develop",
            "dev",
            "staging"
          ],
          "description": "Branches that are not a task. Only used when trackOnlyCreatedBranches is off: time on them is logged as \"General\" (or not at all, see trackGeneralBranches)."
        },
        "workMonitor.trackGeneralBranches": {
          "type": "boolean",
          "default": true,
          "description": "Only used when trackOnlyCreatedBranches is off: log time on general branches (main, develop…) as a \"General\" entry."
        },
        "workMonitor.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start tracking automatically when you switch to a task branch. When off, you are asked first."
        },
        "workMonitor.idleMinutes": {
          "type": "number",
          "default": 10,
          "minimum": 1,
          "description": "Stop counting time after this many minutes without any activity (typing, file changes by agents, terminal commands…)."
        },
        "workMonitor.manualTaskPresets": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "Check issues",
            "Refer docs",
            "Meeting",
            "Code review",
            "Support"
          ],
          "description": "Quick choices offered when starting a non-Jira task."
        },
        "workMonitor.reminderTime": {
          "type": "string",
          "default": "17:30",
          "pattern": "^(([01]\\d|2[0-3]):[0-5]\\d)?$",
          "description": "Time (HH:mm) for the end-of-day final timesheet check. Leave empty to disable."
        },
        "workMonitor.roundToMinutes": {
          "type": "number",
          "default": 15,
          "enum": [
            0,
            5,
            10,
            15,
            30
          ],
          "description": "Round each entry's Time Spent to the nearest step (the Odoo procedure uses 15 minutes: 22 min → 00:15, 27 min → 00:30). 0 = no rounding."
        },
        "workMonitor.projects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Odoo project names offered in the timesheet's Project field. Projects you type are also remembered and suggested again for the same task and repository."
        },
        "workMonitor.progressReminderHours": {
          "type": "number",
          "default": 2,
          "minimum": 0,
          "description": "Remind you to update the timesheet every N hours while time is not logged in Odoo yet (0 = off). Timesheets must be updated several times a day."
        },
        "workMonitor.remindOnTaskSwitch": {
          "type": "boolean",
          "default": true,
          "description": "When you move to another task, remind you if the previous one has time not logged in Odoo yet."
        },
        "workMonitor.breakMinutes": {
          "type": "number",
          "default": 30,
          "minimum": 0,
          "description": "While a non-Jira timer runs, an absence from VS Code this long counts as a break (lunch…) and is left out of the timesheet unless you confirm you were working (0 = off)."
        },
        "workMonitor.jira.baseUrl": {
          "type": "string",
          "default": "",
          "scope": "application",
          "pattern": "^(https://.+)?$",
          "markdownDescription": "Your Jira Cloud site, e.g. `https://your-company.atlassian.net`. Run **Work Monitor: Connect Jira…** to add your API token. User settings only, so a cloned repository can't redirect your credentials."
        }
      }
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "~1.93.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^5.6.0"
  },
  "overrides": {
    "@azure/msal-node": "^7.0.3"
  }
}
